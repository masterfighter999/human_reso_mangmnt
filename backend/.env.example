# ─── Server ───────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000

# ─── Database ─────────────────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=hrms
DB_SSL=false
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/hrms

# ─── JWT ──────────────────────────────────────────────────────────────────────
# Minimum 32 characters each
JWT_SECRET=default_hrms_secret_key_2026
JWT_ACCESS_SECRET=change_this_to_a_random_32_char_string_access
JWT_REFRESH_SECRET=change_this_to_a_random_32_char_string_refresh
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ─── CORS ─────────────────────────────────────────────────────────────────────
CORS_ORIGIN=http://localhost:5173

# ─── Rate Limiting ────────────────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# ─── File Uploads ─────────────────────────────────────────────────────────────
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=5

# ─── Email Configuration ──────────────────────────────────────────────────────
RESEND_API_KEY=re_xxxxxxxxx
